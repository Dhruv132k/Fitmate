# Copy to .env and adjust as needed. docker-compose reads this automatically.

# Postgres
POSTGRES_DB=fitmate
POSTGRES_USER=fitmate
POSTGRES_PASSWORD=fitmate
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
# IMPORTANT: use a long random value (>= 32 chars) in production.
FITMATE_JWT_SECRET=change-me-in-prod-please-use-a-long-random-secret-value
FITMATE_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
# Set to false to disable seeding demo users on first boot.
FITMATE_SEED_ENABLED=true

# Frontend (served by nginx)
FRONTEND_PORT=8081
