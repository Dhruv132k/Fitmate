# Copy to .env and adjust as needed. docker-compose reads this automatically.

# Postgres
POSTGRES_DB=fitmate
POSTGRES_USER=fitmate
POSTGRES_PASSWORD=fitmate
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
# IMPORTANT: use a long random value (>= 32 chars) in production.
FITMATE_JWT_SECRET=change-me-in-prod-please-use-a-long-random-secret-value
FITMATE_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
# Set to false to disable seeding demo users on first boot.
FITMATE_SEED_ENABLED=true

# Frontend (served by nginx)
FRONTEND_PORT=8081

# ---- OAuth / social login (optional) ----
# Keep this FALSE until you have pasted real credentials below. When false the
# app runs normally and only email/password login is active.
# Flip to true AFTER you fill in at least one provider's client id + secret.
FITMATE_OAUTH2_ENABLED=false
# Where the backend redirects after social login (must point at the running frontend).
#   docker-compose frontend: http://localhost:8081/oauth/callback
#   local `npm run dev`:      http://localhost:5173/oauth/callback
FITMATE_OAUTH2_REDIRECT_URI=http://localhost:8081/oauth/callback

# --- Google: paste values from Google Cloud Console (OAuth 2.0 Client ID, "Web application") ---
# Authorized redirect URI to register there: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=PASTE_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_GOOGLE_CLIENT_SECRET_HERE

# --- GitHub (optional, not set up yet) ---
# IMPORTANT: leave these BLANK until you actually configure GitHub. A provider
# with a non-empty client id is treated as "enabled"; a blank one is skipped.
# Authorization callback URL to register there: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
